From the following solutions:
\begin{inparaenum}[(i)]
\item     0.2m \ce{CH_3OH}  in water  %0.2
\item     0.2m \ce{NaF}  in water %0.4
\item     0.2m \ce{Ca(NO_3)_2}  in water %0.3
\end{inparaenum}
select the one with:
\begin{inparaenum}[(a)]
\item     lowest freezing point   % 0.1m \ce{Ca(NO_3)_2}  in water 
\item     highest freezing point  %  0.2m \ce{CH_3OH}  in water
\item     highest boiling point     %  0.1m \ce{Ca(NO_3)_2}  in water
\item     lowest boiling point      % 0.2m \ce{CH_3OH}  in water   
\item     lowest vapor pressure  %  0.1m \ce{Ca(NO_3)_2}  in water 
 \item    highest vapor pressure  % 0.2m \ce{CH_3OH}  in water    
 \item    highest osmotic pressure %   0.1m \ce{Ca(NO_3)_2}  in water 
 \item    lowest osmotic pressure %  0.2m \ce{CH_3OH}  in water  
\end{inparaenum}
