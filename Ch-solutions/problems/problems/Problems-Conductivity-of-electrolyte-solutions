\begin{question}[ID=\the\value{numA}]\SetQuestionProperties{section-title=\nameref{sec:units}}
Classify the following substances based on their conductivity $\kappa$ value. All measurements are made at room temperature and all solutins are 0.01M.
\begin{inparaenum}[(a)]
\item   \ce{CuSO4} 4000$\mu$S$\cdot $cm$^{-1}$     	%strong electrolyte
\item   \ce{FeCl3} 10000$\mu$S$\cdot $cm$^{-1}$		%strong electrolyte
\item   \ce{C_6H_{12}O_6} 9$\mu$S$\cdot $cm$^{-1}$	%nonelectrolyte
\item   \ce{CH_3COOH} 320$\mu$S$\cdot $cm$^{-1}$	%weak electrolyte
\end{inparaenum}
 \end{question}
\begin{solution}
\begin{inparaenum}[(a)]
\item    strong electrolyte
\item    strong electrolyte
\item    nonelectrolyte
\item    weak electrolyte
\end{inparaenum}
\hspace{0.1cm}\end{solution}\stepcounter{numA}%%%%%%%%%%%%


