\begin{equation}
\boxed{r=r_m\cdot\frac{[S] }{K_m + [S] } }
\label{eq:Michaelis-Menten}
\end{equation}
where:
\begin{where}
 \item $r$   is the enzyme-catalyzed reaction rate
 \item $[S]$   is the enzyme concentration
 \item $r_m$   is the maximal velocity
 \item $K_m$   Michaelis constant
\end{where}
