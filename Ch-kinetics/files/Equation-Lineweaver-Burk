\begin{equation}
\boxed{\frac{1}{v}=\frac{K_m}{V}\cdot\frac{1}{[S]} + \frac{1}{V} }
\label{eq:Lineweaver-Burk}
\end{equation}
where:
\begin{where}
 \item $1/v$   is the inverse of the enzyme-catalyzed reaction rate
 \item $1/[S]$   is the inverse of the enzyme concentration
 \item $V_m$   is the maximal velocity
 \item $K_m$   Michaelis constant
\end{where}
