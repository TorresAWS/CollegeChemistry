\begin{equation}
\boxed{\frac{1}{r}=\frac{K_m}{r_m}\cdot\frac{1}{[S]} + \frac{1}{r_m} }
\label{eq:Lineweaver-Burk}
\end{equation}
where:
\begin{where}
 \item $1/r$   is the inverse of the enzyme-catalyzed reaction rate
 \item $1/[S]$   is the inverse of the enzyme concentration
 \item $r_m$   is the maximal velocity
 \item $K_m$   Michaelis constant
\end{where}
