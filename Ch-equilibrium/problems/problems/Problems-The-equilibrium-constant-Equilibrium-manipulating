For the reaction below at a given temperature
\begin{center}\ce{2SO_2_{(g)} + O2_{(g)}  <=> 2SO_3_{(g)}    }\hfill $K_c =4\times 10^{24}$\end{center}
What is the $K_c$ value for the following reactions at the same temperature?
  \begin{inparaenum}[(a)]
\item  \ce{   4SO_2_{(g)} + 2O2_{(g)}  <=> 4SO_3_{(g)}    }   %$1.6\times 10^{49}$
\item  \ce{   SO_2_{(g)} + $\frac{1}{2}$O2_{(g)}  <=> SO_3_{(g)}     }   %$2.2\times 10^{24}$
\item  \ce{   6SO_2_{(g)} + 3O2_{(g)}  <=> 6SO_3_{(g)}      }   %$6.4\times 10^{73}$
  \end{inparaenum}
  \end{question}
\begin{solution}
  \begin{inparaenum}[(a)]
\item   $1.6\times 10^{49}$
\item   $2.2\times 10^{24}$
\item   $6.4\times 10^{73}$
  \end{inparaenum}
\hspace{0.1cm}\end{solution}\stepcounter{numA}%%%%%%%%%%%%


