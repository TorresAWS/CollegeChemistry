  \begin{inparaenum}[(a)]
\item 0.032 M
\item    64\%
\item     $[\ce{Fe^{3+}}]$=0.018M; $[\ce{SCN^{-}}]$=0.018M; $[\ce{FeSCN^{2+}}]$=0.032M; 
  \end{inparaenum}
